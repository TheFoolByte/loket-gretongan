# ---- required ----------------------------------------------------------
# Dashboard password. Min 12 chars. Use: openssl rand -base64 24
ADMIN_PASS=

# ---- recommended -------------------------------------------------------
# Random string; keeps sessions valid across restarts. openssl rand -hex 32
SESSION_SECRET=

# Public hostname of the Railway domain (used by the generator for config links)
PUBLIC_HOST=
# SSH endpoint handed to users (Railway TCP proxy host/port)
SSH_PUBLIC_HOST=
SSH_PUBLIC_PORT=

# Public generator limits
SIGNUP_PER_IP=2          # akun / 24 jam / IP
SIGNUP_DAILY=40          # total akun / hari
SIGNUP_MAX_DAYS=7        # masa aktif maksimum
SIGNUP_BURST=5           # percobaan / 10 menit / IP

# SQLite-free data dir (mount a Railway volume here)
DATA_DIR=/data

# ---- ssh ---------------------------------------------------------------
# Web tier port. Railway may inject PORT when a TCP proxy is attached, so the
# app listens on WEB_PORT instead.
WEB_PORT=8080
SSH_PORT=22
SSH_WS_PATH=/ssh-ws

# ---- vless / trojan (paths must stay unguessable-ish) -------------------
VLESS_PATH=/vless-ws
TROJAN_PATH=/trojan-ws

# 1 = block relaying to private/link-local/metadata addresses (keep it on)
ALLOW_PRIVATE_TARGETS=0

# ---- multi-node egress -------------------------------------------------
# JSON array; each node is a proxy YOU own/rent in that country. The relay
# exits through it, so the exit IP really is in that country.
#   NODES=[{"id":"sg","name":"Singapore","flag":"SG","proxy":"socks5://user:pass@1.2.3.4:1080"}]
# Empty = direct only. Never paste proxy lists you did not buy: those belong to
# someone else, traffic through them is readable by that party, and using them
# is unauthorised access.
NODES=[]
# Hasil Proxy Check bisa dikonversi secara offline (lihat nodes.example.json):
# node scripts/import-nodes.js result_proxy.txt nodes.json --regions '*'
# nodes.json dipasang sebagai /data/nodes.json; scheme auto menebak SOCKS5
# dari port 1080/10808, sisanya HTTP (atau paksa lewat --scheme http|socks5).

# ---- optional ----------------------------------------------------------
# Cloudflare Tunnel for SSH-WS without a public TCP proxy
CF_TUNNEL_TOKEN=
ENABLE_CLOUDFLARED=1

# stunnel "SSH SNI": needs a TCP proxy pointed at 2443
ENABLE_SNI=0
SSH_SSL_PORT=2443

# Login throttle (attempts per IP per minute)
LOGIN_LIMIT=8

# Set to 0 only when serving plain http (local debugging)
COOKIE_SECURE=1
